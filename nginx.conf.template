# Rendered by the nginx image's envsubst step at startup; only ${IMMICH_*} variables are substituted.
proxy_cache_path /var/cache/nginx/immich levels=1:2 keys_zone=immich_thumbs:10m max_size=2g inactive=14d use_temp_path=off;
proxy_cache_path /var/cache/nginx/weather levels=1:2 keys_zone=weather:2m max_size=50m inactive=1d use_temp_path=off;

server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }

    # Per-install settings, written from the environment by docker-entrypoint.d/40-dashboard-config.sh.
    location = /config.json {
        root /run/dashboard;
        default_type application/json;
        add_header Cache-Control "no-store";
    }

    # proxy_pass below uses variables, so hostnames (including Tailscale MagicDNS names) are resolved
    # per request through Docker's embedded DNS. IPv4 only: Docker networks often have no IPv6 route.
    resolver 127.0.0.11 ipv6=off valid=60s;
    proxy_ssl_server_name on;
    proxy_ssl_verify on;
    proxy_ssl_verify_depth 3;
    proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;

    # Read-only allowlist into Immich. The API key is injected here and never reaches the browser.
    location /immich/ { return 404; }

    location ~ ^/immich/(search/(?:random|smart|metadata))$ {
        limit_except POST { deny all; }
        proxy_pass ${IMMICH_URL}/api/$1;
        proxy_set_header x-api-key "${IMMICH_API_KEY}";
        proxy_ssl_verify ${IMMICH_TLS_VERIFY};
        proxy_read_timeout 30s;
    }

    location ~ ^/immich/((?:assets|people)/[0-9a-f-]+/thumbnail)$ {
        limit_except GET { deny all; }
        proxy_pass ${IMMICH_URL}/api/$1$is_args$args;
        proxy_set_header x-api-key "${IMMICH_API_KEY}";
        proxy_ssl_verify ${IMMICH_TLS_VERIFY};
        proxy_read_timeout 30s;
        proxy_cache immich_thumbs;
        proxy_cache_key $uri$is_args$args;
        proxy_cache_valid 200 14d;
        proxy_ignore_headers Cache-Control Expires Set-Cookie;
        add_header X-Cache $upstream_cache_status;
    }

    location ~ ^/immich/(albums|people|memories|faces|(?:albums|assets)/[0-9a-f-]+)$ {
        limit_except GET { deny all; }
        proxy_pass ${IMMICH_URL}/api/$1$is_args$args;
        proxy_set_header x-api-key "${IMMICH_API_KEY}";
        proxy_ssl_verify ${IMMICH_TLS_VERIFY};
        proxy_read_timeout 30s;
    }

    # Weather, proxied so the page is fully same-origin. Cached briefly, and served stale (up to a
    # day) if the upstream is unreachable, so an internet blip never turns into a failed request.
    location = /wx/forecast {
        limit_except GET { deny all; }
        proxy_pass https://api.open-meteo.com/v1/forecast$is_args$args;
        proxy_cache weather;
        proxy_cache_valid 200 5m;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504 http_429;
        proxy_cache_background_update on;
        proxy_cache_lock on;
        proxy_ignore_headers Cache-Control Expires Set-Cookie;
    }

    location = /wx/air {
        limit_except GET { deny all; }
        proxy_pass https://air-quality-api.open-meteo.com/v1/air-quality$is_args$args;
        proxy_cache weather;
        proxy_cache_valid 200 15m;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504 http_429;
        proxy_cache_background_update on;
        proxy_cache_lock on;
        proxy_ignore_headers Cache-Control Expires Set-Cookie;
    }

    location = /wx/alerts {
        limit_except GET { deny all; }
        proxy_pass https://api.weather.gov/alerts/active$is_args$args;
        proxy_set_header User-Agent "immich-dashboard (self-hosted photo frame)";
        proxy_set_header Accept "application/geo+json";
        proxy_cache weather;
        proxy_cache_valid 200 2m;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504 http_429;
        proxy_cache_background_update on;
        proxy_cache_lock on;
        proxy_ignore_headers Cache-Control Expires Set-Cookie Vary;
    }
}
