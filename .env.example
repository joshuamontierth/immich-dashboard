# Copy to .env and fill in. docker compose reads .env automatically; it is git-ignored.

# --- Immich (required) ---------------------------------------------------------------------
# Your Immich server as this container can reach it: scheme, host and port, no trailing /api.
IMMICH_URL=http://192.168.1.10:2283
# Immich > Account Settings > API Keys. Read-only permissions are enough (see README).
IMMICH_API_KEY=
# Set to "off" only if Immich uses a self-signed HTTPS certificate.
IMMICH_TLS_VERIFY=on

# --- Location and weather --------------------------------------------------------------------
# Coordinates for the forecast. Leave empty to turn weather off.
DASHBOARD_LATITUDE=
DASHBOARD_LONGITUDE=
# Short label shown with the current conditions (optional).
DASHBOARD_LOCATION_NAME=
# metric or imperial
DASHBOARD_UNITS=metric
# IANA timezone for the clock and schedule, e.g. America/Chicago. Empty: the screen's own timezone.
TZ=

# --- Photos ------------------------------------------------------------------------------------
# Album for the Gallery and Dashboard presets: the UUID at the end of the album's URL in Immich.
# Empty: the whole library.
DASHBOARD_ALBUM_ID=

# --- Captions ----------------------------------------------------------------------------------
# Display names, keyed by the person's full name in Immich: "Full Name=Nickname,Full Name=Nickname"
DASHBOARD_NICKNAMES=
# People always listed first when they're in a photo, in order: "Full Name,Full Name"
DASHBOARD_PEOPLE_FIRST=
# Names starting with one of these titles are shown in full ("Aunt Jo", not "Aunt").
# Empty uses the default below; "none" turns this off.
DASHBOARD_NAME_TITLES=Dr,Mr,Mrs,Ms,Aunt,Uncle,Grandma,Grandpa

# --- Auto schedule -----------------------------------------------------------------------------
# When the auto schedule switches presets: "HH:MM=preset,...". Built-in presets: gallery, dashboard,
# forecast, memories, night. Empty uses this default.
DASHBOARD_SCHEDULE=06:00=forecast,09:00=gallery,17:00=dashboard,22:00=night

# --- Server ------------------------------------------------------------------------------------
DASHBOARD_PORT=8090
